# ============================================================================
# Jeepay 生产环境配置
# 将此文件复制到服务器并重命名为 .env，按需修改配置
# 部署命令：
#   docker compose --env-file .env -f docker-compose.prod.yml up -d
# ============================================================================

# ---- 阿里云 ACR 镜像仓库（国内网络友好） ----
# GitHub Actions 构建后推送到你的阿里云 ACR 仓库
# 在服务器部署前需要先登录：
#   docker login ${ALIYUN_REGISTRY_URL}
ALIYUN_REGISTRY_URL=registry.cn-hangzhou.aliyuncs.com
ALIYUN_NAMESPACE=jeepay

# ---- MySQL 配置 ----
MYSQL_ROOT_PASSWORD=rootroot
MYSQL_DATABASE=jeepaydb
MYSQL_USER=jeepay
MYSQL_PASSWORD=jeepay

# ---- 基础镜像配置（国内使用阿里云镜像加速） ----
# 各服务的镜像地址格式：
#   基础设施：${ALIYUN_REGISTRY_URL}/jeequan/{镜像名}:{标签}
#   业务服务：${ALIYUN_REGISTRY_URL}/${ALIYUN_NAMESPACE}/jeepay-{模块名}:latest
# 如需覆盖基础镜像，可在此设置：
# MYSQL_IMAGE=registry.cn-hangzhou.aliyuncs.com/jeequan/mysql:8.0
# REDIS_IMAGE=registry.cn-hangzhou.aliyuncs.com/jeequan/redis:6.2.14
# ROCKETMQ_IMAGE=registry.cn-hangzhou.aliyuncs.com/jeequan/rocketmq:5.3.1

# ---- Redis 配置 ----
REDIS_PASSWORD=

# ---- 部署路径（宿主机挂载目录） ----
# 日志、上传文件、配置文件都会挂载到这些目录
DEPLOY_BASE=/opt/jeepay/data

# ---- 服务端口映射（宿主机端口:容器端口） ----
PAYMENT_PORT=9216
MANAGER_PORT=9217
MERCHANT_PORT=9218
MYSQL_PORT=13306
REDIS_PORT=6380
